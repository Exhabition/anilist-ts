{
  "name": "anilist-ts",
  "version": "1.1.1",
  "description": "A fully typed, projection-based AniList GraphQL SDK for Node.js and browsers",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./redis": {
      "types": "./dist/redis.d.ts",
      "import": "./dist/redis.js",
      "require": "./dist/redis.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "schema:sync": "node scripts/schema-sync.mjs",
    "schema:generate": "node scripts/schema-generate.mjs",
    "schema:check": "node scripts/schema-check.mjs",
    "schema:live-check": "node scripts/live-schema-check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "readme:check": "node scripts/extract-readme-examples.mjs && tsc --noEmit -p tsconfig.readme.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.types.json && tsc --noEmit -p tsconfig.examples.json && npm run readme:check",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "build": "tsup",
    "docs": "typedoc",
    "health": "node scripts/check-architecture.mjs",
    "smoke": "node scripts/smoke-package.mjs",
    "package:check": "node scripts/package-check.mjs && npm pack --dry-run --json --ignore-scripts --cache ./.npm-cache",
    "verify": "npm run schema:check && npm run format:check && npm run lint && npm run typecheck && npm run coverage && npm run health && npm run build && npm run smoke && npm run package:check",
    "prepare": "npm run build",
    "prepublishOnly": "npm run verify"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Exhabition/anilist-ts.git"
  },
  "homepage": "https://exhabition.github.io/anilist-ts/",
  "bugs": {
    "url": "https://github.com/Exhabition/anilist-ts/issues"
  },
  "author": "Luke <63742759+Exhabition@users.noreply.github.com>",
  "keywords": [
    "anilist",
    "graphql",
    "sdk",
    "typescript",
    "anime",
    "manga"
  ],
  "license": "GPL-3.0-only",
  "peerDependencies": {
    "redis": ">=4 <7"
  },
  "peerDependenciesMeta": {
    "redis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "graphql": "^16.14.2",
    "prettier": "^3.9.6",
    "redis": "^6.2.1",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
